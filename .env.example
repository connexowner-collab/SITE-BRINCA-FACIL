# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Estas duas são PÚBLICAS por definição (vão para o navegador). A proteção real é o RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (usado em links, sitemap e prévia de compartilhamento)
NEXT_PUBLIC_SITE_URL=

# Opcional: captcha Cloudflare Turnstile no formulário de cotação
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Opcional e SECRETA: só no servidor. Na Vercel, marque como Sensitive. Nunca use prefixo NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
